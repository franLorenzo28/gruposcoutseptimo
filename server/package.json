    "fastify-type-provider-zod": "7.0.0",
    "google-auth-library": "11.0.2",
    "jsonwebtoken": "^9.0.2",
    "nodemailer": "10.0.0",
    "pg": "^8.23.0",
    "zod": "4.4.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@fastify/swagger": "9.8.1",
