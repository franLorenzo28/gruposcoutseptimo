NODE_ENV=development
HOST=0.0.0.0
PORT=4000
LOG_LEVEL=info
ORIGIN=http://localhost:5173,http://127.0.0.1:5173
BODY_LIMIT_BYTES=1048576
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW=1 minute

# Supabase. La publishable/anon key permite verificar usuarios y salud.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me
# Compatibilidad con proyectos que todavía usan la clave anon JWT:
# SUPABASE_ANON_KEY=replace_me
SUPABASE_TIMEOUT_MS=3000
READINESS_CACHE_MS=5000

# Sólo servidor: operaciones administrativas. Nunca exponer al frontend.
SUPABASE_SERVICE_ROLE_KEY=replace_me

# Bootstrap de administradores. La autorización normal usa app_metadata.role.
# Mantener estas listas cortas y auditadas; no usar patrones de correo.
ADMIN_USER_IDS=
ADMIN_EMAILS=
