NODE_ENV=development
HOST=0.0.0.0
PORT=4000
LOG_LEVEL=info
AUTH_MODE=supabase
ORIGIN=http://localhost:5173,http://127.0.0.1:5173
BODY_LIMIT_BYTES=1048576
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW=1 minute

# Supabase. La publishable/anon key permite verificar usuarios y salud.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me
# Compatibilidad con proyectos que todavía usan la clave anon JWT:
# SUPABASE_ANON_KEY=replace_me
SUPABASE_TIMEOUT_MS=3000
READINESS_CACHE_MS=5000

# Conexion SQL directa. Durante la transicion puede usar la conexion `postgres`
# del proyecto restaurado; antes de produccion se debe crear un login dedicado
# y otorgarle solo los permisos documentados para el backend.
# DATABASE_URL=postgresql://postgres.project:encoded_password@host:5432/postgres
# DATABASE_SSL=verify-full
# DATABASE_POOL_MAX=10
# DATABASE_TIMEOUT_MS=5000

# Sólo servidor: operaciones administrativas. Nunca exponer al frontend.
SUPABASE_SERVICE_ROLE_KEY=replace_me

# Modo local: Supabase Data API se usa sólo como base de datos. No se usa
# Supabase Auth para emitir ni validar sesiones.
# AUTH_MODE=local
# JWT_SECRET=replace_with_at_least_32_random_characters
# JWT_ACCESS_TTL=1h
# PASSWORD_RESET_TTL_MINUTES=60

# En producción local: HTTPS y correo obligatorios. En desarrollo se devuelven
# enlaces para pruebas si no hay SMTP. Nunca usar NODE_ENV=development en producción.
# APP_URL=https://example.com
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=replace_me
# SMTP_PASSWORD=replace_me
# SMTP_FROM=no-reply@example.com

# Google OAuth local. Registrar exactamente GOOGLE_REDIRECT_URI como URI de
# redireccion autorizada en Google Cloud; el callback pertenece a Fastify.
# GOOGLE_CLIENT_ID=replace_me
# GOOGLE_CLIENT_SECRET=replace_me
# GOOGLE_REDIRECT_URI=https://example.com/v1/auth/google/callback
# GOOGLE_OAUTH_TTL_MINUTES=10

# Bootstrap de administradores. La autorización normal usa app_metadata.role.
# Mantener estas listas cortas y auditadas; no usar patrones de correo.
ADMIN_USER_IDS=
ADMIN_EMAILS=
