NODE_ENV=development
HOST=0.0.0.0
PORT=4000
LOG_LEVEL=info
ORIGIN=http://localhost:5173,http://127.0.0.1:5173
BODY_LIMIT_BYTES=1048576
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW=1 minute

# Supabase. La publishable/anon key permite verificar usuarios y salud.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me
# Compatibilidad con proyectos que todavía usan la clave anon JWT:
# SUPABASE_ANON_KEY=replace_me
SUPABASE_TIMEOUT_MS=3000

# Para módulos administrativos futuros. Nunca exponer al frontend.
# SUPABASE_SERVICE_ROLE_KEY=replace_me

# Variables del servidor Express legado, a retirar en fases posteriores.
JWT_SECRET=super-secret-change-me
ADMIN_IPS=127.0.0.1

# Email Service Configuration
SMTP_HOST=mailhog
SMTP_PORT=1025
FROM_EMAIL=noreply@scout-local.dev
APP_URL=http://localhost:5173

# Producción: configurar con servidor SMTP real
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASS=your-app-password
# FROM_EMAIL=noreply@gruposcout.org
# APP_URL=https://tu-dominio.com
